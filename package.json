{
	"name": "sveltemyadmin",
	"private": true,
	"version": "0.0.1",
	"license": "GPL-2.0-or-later",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest run --project unit",
		"test": "vitest run --project unit --project client",
		"test:e2e": "playwright test",
		"test:client": "vitest run --project client",
		"test:integration": "vitest run --project integration",
		"i18n:extract": "node scripts/i18n/extract.ts",
		"i18n:import-mo": "node scripts/i18n/import-mo.ts",
		"i18n:check": "node scripts/i18n/check.ts",
		"storage:import-pmadb": "node scripts/storage/import-pmadb.ts",
		"db:up": "docker compose up -d --wait",
		"db:down": "docker compose down -v",
		"site:screenshots": "node scripts/site/capture-screenshots.ts"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/inter": "^5.3.0",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.62.0",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.5",
		"@types/pdfkit": "0.17.7",
		"@types/qrcode": "1.5.6",
		"@vitest/browser-playwright": "^5.0.5",
		"bits-ui": "^2.20.2",
		"cn": "^0.5.0",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"fast-xml-parser": "^5.11.2",
		"globals": "^17.6.0",
		"paneforge": "^1.0.2",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"shadcn-svelte": "^1.7.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.6.0",
		"svelte-sonner": "^1.2.2",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.5",
		"vitest": "^5.0.5",
		"vitest-browser-svelte": "^3.1.0",
		"xlsx": "0.18.5",
		"yaml": "^2.9.1"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@codemirror/autocomplete": "6.20.4",
		"@codemirror/commands": "6.11.1",
		"@codemirror/lang-sql": "6.10.0",
		"@codemirror/language": "6.13.1",
		"@codemirror/lint": "6.9.7",
		"@codemirror/search": "6.7.2",
		"@codemirror/state": "6.7.6",
		"@codemirror/view": "6.43.15",
		"@lezer/highlight": "1.2.5",
		"@simplewebauthn/browser": "14.0.0",
		"@simplewebauthn/server": "14.0.3",
		"@tanstack/table-core": "^9.3.1",
		"dejavu-fonts-ttf": "2.37.3",
		"fflate": "0.8.3",
		"iconv-lite": "0.7.3",
		"mode-watcher": "^1.1.0",
		"mysql2": "^3.24.6",
		"pdfkit": "0.20.2",
		"qrcode": "1.5.4",
		"sql-formatter": "15.9.0",
		"zod": "^4.6.7"
	},
	"engines": {
		"node": ">=22.13"
	}
}
